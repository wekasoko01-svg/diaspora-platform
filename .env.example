# ───────────────────────────────────────────
# DiasporaLink - Environment Variables
# ───────────────────────────────────────────

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/diaspora_platform"

# API
PORT=4000
FRONTEND_URL="http://localhost:3000"
NODE_ENV=development

# Auth
JWT_SECRET="replace-with-a-secure-random-string"
SESSION_SECRET="replace-with-another-secure-random-string"

# ── Email (Nodemailer) ─────────────────────
# Dev: use Mailpit (localhost:1025, no auth)
# Production: use SendGrid SMTP or any SMTP provider
EMAIL_HOST="localhost"
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="noreply@diasporalink.com"

# ── File Uploads ───────────────────────────
# driver: "local" (dev) or "s3" (production)
UPLOAD_DRIVER="local"
UPLOAD_DIR="./uploads"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET="diaspora-uploads"

# ── M-Pesa Daraja API ──────────────────────
# Sandbox defaults shown. Get live creds at https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE="174379"
MPESA_ENV="sandbox"    # "sandbox" | "production"
MPESA_CALLBACK_URL="https://your-domain.com/payments/mpesa-callback"

# ── Sentry Error Monitoring ────────────────
SENTRY_DSN=""
SENTRY_ENVIRONMENT=development
SENTRY_ORG=""
SENTRY_PROJECT=""

# ── Frontend (Next.js) ─────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
