{
  "name": "diaspora-platform",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "db:generate": "pnpm --filter @diaspora/db generate",
    "db:push": "pnpm --filter @diaspora/db push",
    "db:migrate": "pnpm --filter @diaspora/db migrate",
    "db:seed": "pnpm --filter @diaspora/db seed",
    "db:studio": "pnpm --filter @diaspora/db studio",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
