generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  CLIENT
  STAFF
  ADMIN
  FOUNDER
}

enum BookingStatus {
  NEW
  PENDING_REVIEW
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  MPESA
  BANK_TRANSFER
  CARD
  CASH
}

enum ServiceType {
  LAND_VERIFICATION
  CONSTRUCTION_MONITORING
  VEHICLE_INSPECTION
  RELOCATION_SUPPORT
  FAMILY_SUPPORT
  FRAUD_PREVENTION
  DOCUMENT_FACILITATION
  CONSULTATION
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  phone        String
  passwordHash String
  role         Role     @default(CLIENT)
  country      String?
  avatarUrl    String?
  emailVerified Boolean @default(false)
  verificationToken String? @unique
  verificationExpires DateTime?
  resetToken        String? @unique
  resetExpires      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings              Booking[]
  serviceRequests       ServiceRequest[]
  payments              Payment[]
  documents             Document[]
  notes                 Note[]
  auditLogs             AuditLog[]
  notificationPreference NotificationPreference?
  sentMessages          Message[]
}

model Booking {
  id         String        @id @default(cuid())
  userId     String
  serviceType ServiceType
  message    String
  budget     String?
  priority   RequestPriority @default(MEDIUM)
  status     BookingStatus @default(NEW)
  scheduledAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  payments Payment[]
  messages Message[]

  @@index([userId])
  @@index([status])
}

model ServiceRequest {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String
  priority    RequestPriority @default(MEDIUM)
  status      RequestStatus  @default(OPEN)
  assignedTo  String?
  dueDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  verifications Verification[]
  notes        Note[]

  @@index([userId])
  @@index([assignedTo])
  @@index([status])
}

model Verification {
  id         String   @id @default(cuid())
  requestId  String
  location   String
  result     String?
  reportUrl  String?
  evidenceUrl String?
  conductedBy String?
  conductedAt DateTime?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  request ServiceRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
}

model Payment {
  id        String        @id @default(cuid())
  userId    String
  bookingId String?
  amount    Decimal
  currency  String        @default("KES")
  status    PaymentStatus @default(PENDING)
  method    PaymentMethod?
  reference String?
  notes     String?
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([userId])
  @@index([status])
}

model Invoice {
  id        String   @id @default(cuid())
  userId    String
  bookingId String?
  number    String   @unique
  amount    Decimal
  currency  String   @default("KES")
  status    String   @default("DRAFT")
  dueDate   DateTime?
  issuedAt  DateTime @default(now())
  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Document {
  id          String   @id @default(cuid())
  userId      String
  requestId   String?
  name        String
  type        String
  url         String
  size        Int?
  uploadedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([requestId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  requestId String?
  content   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  request ServiceRequest? @relation(fields: [requestId], references: [id])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  author      String?
  imageUrl    String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([published])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  content   String
  rating    Int?
  avatarUrl String?
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     Boolean  @default(true)
  sms       Boolean  @default(false)
  whatsapp  Boolean  @default(true)
  push      Boolean  @default(false)
  marketing Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  bookingId String?
  senderId  String
  content   String
  readAt    DateTime?
  createdAt DateTime @default(now())

  sender  User     @relation(fields: [senderId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([senderId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
